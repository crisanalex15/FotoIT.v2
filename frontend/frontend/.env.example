# Copiază acest fișier în .env.local și completează valorile.

# Adresa internă a backend-ului Spring Boot. Browserul nu o vede: Next.js
# trimite cererile /api/gallery/* mai departe către ea (vezi next.config.ts).
BACKEND_URL=http://localhost:8080

# Lasă gol ca browserul să folosească același domeniu (recomandat, merge și prin Cloudflare Tunnel).
# Setează doar dacă backend-ul e public pe alt domeniu, ex: https://api.fotoit.ro
NEXT_PUBLIC_API_URL=

# URL public al site-ului (opțional, pentru metadata / share)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
