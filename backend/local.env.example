# Copiaza acest fisier ca backend/local.env (ignorat de git) si completeaza valorile.
# Este citit automat de start-dev.bat. In productie seteaza-le ca variabile de mediu.

# Parola panoului /admin. Fara ea se genereaza una aleatorie la fiecare pornire.
ADMIN_PASSWORD=schimba-ma

# Adresa publica a site-ului (pentru link-urile de galerie din admin)
FRONTEND_URL=http://localhost:3000

# Originile frontend-ului, separate prin virgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Credentialele Google Drive pot sta si in src/main/resources/fotoit-gallery-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\cale\catre\credentiale.json
